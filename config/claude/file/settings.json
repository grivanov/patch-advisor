{
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [],
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(hostname)",
      "Bash(date:*)",
      "Bash(uname:*)",
      "Bash(sha256sum:*)",
      "Bash(mkdir -p:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(sort:*)",
      "Bash(curl:*)",
      "Bash(jq:*)",
      "WebFetch",
      "Edit(//work/reports/**)",
      "Edit(//work/cache/**)"
    ],
    "deny": [
      "mcp__outline",
      "Edit(//work/CLAUDE.md)",
      "Edit(//work/.claude/**)",
      "Edit(//work/.mcp.json)",
      "Edit(//work/inventory/**)",
      "Bash(cd:*)"
    ]
  }
}