# patch-advisor per-server settings.
# Copy to .env (cp .env.example .env) and fill in. Read by Docker Compose and by bin/run-patch-advisor.sh.
# Values set in the environment (e.g. xyOps event parameters) take precedence over this file.

# --- Required -------------------------------------------------------------
# Install location (absolute path, no spaces). Written by bin/setup.sh and kept up to date by the scripts.
PATCH_ADVISOR_DIR=
# Server name; Claude uses it to find this server's documents in Outline / report folder.
# Usually the output of `hostname`.
PATCH_ADVISOR_HOST=

# Your Outline host (e.g. your-team.getoutline.com or wiki.example.com). bin/update.sh writes it into
# config/claude/mcp.json and config/nono/patch-advisor.json after every update. Needed for outline mode.
OUTLINE_HOST=

# Ubuntu release of the image; match the host's release (e.g. 24.04). Release only, not 24.04.5.
#UBUNTU_VERSION=26.04

# --- Optional: run defaults (can also be set per run as xyOps event parameters) ---
# Job type: outline (report to Outline) or file (Markdown report in reports/, no Outline)
#PATCH_ADVISOR_MODE=outline
# nono profile: patch-advisor (Claude subscription token) or patch-advisor-apikey (Console API key)
#PATCH_ADVISOR_PROFILE=patch-advisor
# Result output at the end of a run: xyops (default: JSON lines in xyOps' wire protocol) or plain (one readable line,
# e.g. for cron or a systemd timer)
#PATCH_ADVISOR_OUTPUT=xyops
# Claude model: an alias (sonnet = good balance, opus = deeper analysis, more usage) or a full model name.
# Must be available on your Claude plan / API key.
#PATCH_ADVISOR_MODEL=sonnet
# Time limit for one run, in seconds
#MAX_SECONDS=360         # 6 minutes; a warm-cache run takes 1-2 minutes

# --- Optional: log retention ----------------------------------------------
#RUN_LOG_DAYS=30          # per-run logs: gzipped after 1 day, deleted after this many days
#ISSUES_ROTATE_DAYS=7     # start a new issues.log after this many days...
#ISSUES_MAX_MB=50         # ...or when it reaches this size
#ISSUES_KEEP=26           # archived issues logs to keep
#TRANSCRIPT_DAYS=30       # Claude Code session transcripts

# --- Optional: cache ------------------------------------------------------
#CACHE_DAYS=30            # cached release notes / vulnerability data older than this are deleted
#PATCH_ADVISOR_REFRESH=false   # true = clear the cache and fetch everything again (better set per run)

# --- Optional: notifications after each run ------------------------------
# Sent by bin/run-patch-advisor.sh on the host (the agent never sees these values).
# This file then contains secrets: keep it readable by root only (chmod 600 .env).
#
# Reports (successful runs):
#NOTIFY_ON=always               # always | findings (only if security/breaking/urgent > 0) | failure (no reports, failures only)
#NTFY_URL=https://ntfy.sh/your-report-topic
#NTFY_TOKEN=                    # access token for a protected ntfy topic/server
#WEBHOOK_URL=https://example.com/hooks/patch-reports
#WEBHOOK_AUTH_HEADER=Authorization: Bearer your-token
#
# Failed runs (timeouts, errors, report not saved). Each one falls back to the report setting above if unset;
# set a *_FAILURE_URL to "none" to send no failure notifications there.
#NTFY_FAILURE_URL=https://ntfy.sh/your-alerts-topic
#NTFY_FAILURE_TOKEN=
#WEBHOOK_FAILURE_URL=https://example.com/hooks/ops-alerts
#WEBHOOK_FAILURE_AUTH_HEADER=Authorization: Bearer other-token
